Test1CalculateIntegerBits
{
    setglobal gLocalTestName "Test1CalculateIntegerBits"

    set var::Test1CalculateIntegerBits      1
    set bitCount::Test1CalculateIntegerBits 0
    label LoopStart_Test1CalculateIntegerBits
        if var::Test1CalculateIntegerBits == 0
            goto LoopExit_Test1CalculateIntegerBits
        end if
        
        set bitCount::Test1CalculateIntegerBits + 1
        set var::Test1CalculateIntegerBits * 2
        goto LoopStart_Test1CalculateIntegerBits
    label LoopExit_Test1CalculateIntegerBits
    
    message "Found Integer type to be" bitCount::Test1CalculateIntegerBits "bits\r"
    setglobal gABIIntReturn bitCount::Test1CalculateIntegerBits
}

// Assumes 2s complement
Test1IsIntegerSigned
{
    setglobal gLocalTestName "Test1IsIntegerSigned"

    set var::Test1IsIntegerSigned      1
    label LoopStart_Test1IsIntegerSigned
        if var::Test1IsIntegerSigned > 0
            set var::Test1IsIntegerSigned * 2
            goto LoopStart_Test1IsIntegerSigned
        end if
    label LoopExit_Test1IsIntegerSigned
    
    if var::Test1IsIntegerSigned < 0
        message "Found Integer type to be signed\r"
        setglobal gABIIntReturn 1
    else
        message "Found Integer type to be unsigned\r"
        setglobal gABIIntReturn 0
    end if
}


