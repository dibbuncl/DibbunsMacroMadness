// Test nested loops that share variable names across function scopes.
// BUG: See description of Test2LocalScope above
Test2LocalScope3
{
    setglobal gLocalTestName "Test2LocalScope3"

    set loopVar 0
    label LoopStart_Test2LocalScope3
//  {
        setglobal gABIStringReturn + "|"
        setglobal gABIIntArg1 loopVar
        call Test2LocalScope3_subroutine
        set loopVar + 1
        if loopVar < 10
            goto LoopStart_Test2LocalScope3
        end if
//  }

    //stack cleanup
    setglobal gABIIntArg1 0
}

Test2LocalScope3_subroutine
{
    set string "a b c d e f g h i j k l m n o p q r s t u v w x y z"
    set loopVar gABIIntArg1         // name is the same as the calling routine
    
    set loopStop loopVar
    set loopStop + 3
    
    label LoopStart_Test2LocalScope3_subroutine
//  {
        setglobal gABIStringReturn + string.word[loopVar]
        
        set loopVar + 1
        if loopVar < loopStop
            goto LoopStart_Test2LocalScope3_subroutine
        end if
//  }
}

// This is the same as Test2LocalScope3 above, except we namespace the local variables
Test2LocalScope3Namespaced
{
    setglobal gLocalTestName "Test2LocalScope3Namespaced"

    set loopVar::Test2LocalScope3Namespaced 0
    label LoopStart_Test2LocalScope3
//  {
        setglobal gABIStringReturn + "|"
        setglobal gABIIntArg1 loopVar::Test2LocalScope3Namespaced
        call Test2LocalScope3_subroutineNamespaced
        set loopVar::Test2LocalScope3Namespaced + 1
        if loopVar::Test2LocalScope3Namespaced < 10
            goto LoopStart_Test2LocalScope3
        end if
//  }

    //stack cleanup
    setglobal gABIIntArg1 0
}

Test2LocalScope3_subroutineNamespaced
{
    set string "a b c d e f g h i j k l m n o p q r s t u v w x y z"
    set loopVar::Test2LocalScope3_subroutineNamespaced gABIIntArg1         // name is the same as the calling routine
    
    set loopStop::Test2LocalScope3_subroutineNamespaced loopVar::Test2LocalScope3_subroutineNamespaced
    set loopStop::Test2LocalScope3_subroutineNamespaced + 3
    
    label LoopStart_Test2LocalScope3_subroutineNamespaced
//  {
        setglobal gABIStringReturn + string.word[loopVar::Test2LocalScope3_subroutineNamespaced]
        
        set loopVar::Test2LocalScope3_subroutineNamespaced + 1
        if loopVar::Test2LocalScope3_subroutineNamespaced < loopStop::Test2LocalScope3_subroutineNamespaced
            goto LoopStart_Test2LocalScope3_subroutineNamespaced
        end if
//  }
}

